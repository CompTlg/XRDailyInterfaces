# Auto detect text files and normalize line endings to LF
* text=auto eol=lf
# Unity text files
*.cs text diff=csharp
*.shader text
*.meta text
*.unity text
*.prefab text
*.asset text
*.mat text
*.json text
*.yaml text
*.yml text
*.txt text
*.md text
*.asmdef text
*.asmref text
# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.fbx filter=lfs diff=lfs merge=lfs -text
*.mp3 binary
*.wav filter=lfs diff=lfs merge=lfs -text
*.ogg binary
*.aac binary
*.unitypackage binary
*.bundle binary
*.psd filter=lfs diff=lfs merge=lfs -text
*.tga binary
*.tif binary
*.dll binary
*.so binary
*.dylib binary
*.exe binary
*.mp4 filter=lfs diff=lfs merge=lfs -text
